# Modèle de configuration pour bittytax_conv — copier en `.env` puis renseigner.
#   cp sample.env .env
# Charger avant de lancer bittytax_conv / bittytax (cf. README du projet) :
#   set -o allexport && source .env && set +o allexport

# Fichier d'annotations des swaps EVM requalifiés en Trade (chemin ABSOLU).
# Pointe sur datas/evm_overrides.csv : fournit le Trade complet (jambe native + jeton reçu)
# et sert de liste d'exclusion par txid pour le parser etherscan. Cf. ADR 0006.
EVM_OVERRIDES_FILE="/absolute/path/to/datas/evm_overrides.csv"

# Fichier d'annotations des dépôts Binance requalifiés (chemin ABSOLU).
# Pointe sur datas/binance_overrides.csv : fournit la ligne Gift-Received (don d'un tiers)
# et sert de liste d'exclusion par clé UTC_Time|Coin|Change (colonne Raw Data) pour le
# parser binance — un statement Binance n'a pas de txid. Cf. ADR 0007.
BINANCE_OVERRIDES_FILE="/absolute/path/to/datas/binance_overrides.csv"
