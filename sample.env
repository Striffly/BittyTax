# Modèle de configuration pour bittytax_conv — copier en `.env` puis renseigner.
#   cp sample.env .env
# Charger avant de lancer bittytax_conv / bittytax (cf. README du projet) :
#   set -o allexport && source .env && set +o allexport

# Fichier d'annotations des swaps EVM requalifiés en Trade (chemin ABSOLU).
# Pointe sur evm_overrides.csv : fournit le Trade complet (jambe native +
# jeton reçu) et sert de liste d'exclusion par txid pour le parser etherscan. Cf. ADR 0006.
EVM_OVERRIDES_FILE=""

# Fichier d'annotations des dépôts Binance requalifiés (chemin ABSOLU).
# Pointe sur binance_overrides.csv : fournit la ligne Gift-Received (don d'un
# tiers) et sert de liste d'exclusion par clé UTC_Time|Coin|Change (colonne Raw Data) pour le
# parser binance — un statement Binance n'a pas de txid. Cf. ADR 0007.
BINANCE_OVERRIDES_FILE=""

# Export officiel "Withdrawal History" de Binance (chemin ABSOLU) — source des frais réseau RÉELS.
# Pointe sur datas/wallets/Binance-Withdraw-History-*.csv (Time,Coin,Network,Amount,Fee,Address,
# TXID,Status). Le parser binance y lit le frais réel de chaque retrait "fee is included"
# (clé d'appariement (Coin, Amount+Fee) = (Coin, |Change|)), l'isole en colonne Fee et le retranche
# du montant transféré pour équilibrer le contrôle de transferts à l'audit. Cf. ADR 0008.
BINANCE_WITHDRAW_HISTORY_FILE=""

# Frais réseau (gas) DÉRIVÉS dépensés hors des wallets tracés (chemin ABSOLU).
# Pointe sur datas/overrides/binance_gas_hors_perimetre.csv (Coin,Change,GasExtra,Note). Mesuré
# on-chain (pas dans un export Binance) : gas consommé sur des wallets intermédiaires non suivis
# lors d'un transfert. Le parser l'AJOUTE à la Fee du retrait (Coin,|Change|) pour solde exact +
# audit équilibré. Frais réseau = non-cession. Cf. ADR 0010.
BINANCE_GAS_OVERRIDES_FILE=""
